[Unit]
Description=Mirror the GAP manuals hourly
Documentation=https://github.com/gap-system/GapWWW

[Timer]
# Releases are rare, so hourly is ample; the manuals of a new release appear
# within an hour of it ceasing to be a pre-release.
OnCalendar=hourly
Persistent=true
RandomizedDelaySec=10min

[Install]
WantedBy=timers.target
